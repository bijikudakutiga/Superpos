# Salin file ini jadi ".env" untuk development lokal, isi dengan kredensial
# project Supabase kamu. Untuk deploy di Netlify, isi nilai yang sama di
# Site settings > Environment variables (bukan lewat file ini).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-key-supabase-kamu-di-sini
